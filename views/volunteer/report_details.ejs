<%- include('../partials/header', { title: refNo(r.id) }) %>
<div class="page-head"><h1><%= r.title %></h1><span><%- badge(r.status) %> <button type="button" class="btn ghost small noprint" data-print>Print / Save as PDF</button></span></div>
<div class="two">
  <div>
    <div class="card">
      <dl class="info">
        <dt>Reference</dt><dd><%= refNo(r.id) %></dd>
        <dt>Category</dt><dd><%= r.category %></dd>
        <dt>Location</dt><dd><%= r.location %></dd>
        <dt>Priority</dt><dd><%- prio(r.priority) %></dd>
        <dt>Reported by</dt><dd><%= r.resident_name %> <span class="muted"><%= r.resident_phone %></span></dd>
      </dl>
      <h3 style="margin-top:20px">Description</h3>
      <p><%- nl2br(r.description) %></p>
      <% if (r.photo) { %><img class="photo" src="<%= BASE_URL %>/assets/uploads/<%= r.photo %>" alt="Photo attached to the report"><% } %>
      <%- renderMapView(r) %>
    </div>
    <div class="card"><h2>History</h2><%- renderTimeline(r.id) %></div>
  </div>
  <div class="card">
    <h2>Update progress</h2>
    <% if (!open) { %>
      <p class="muted">This report is <%= statusLabel(r.status) %> and can no longer be changed.</p>
    <% } else { %>
      <% for (const er of errors) { %><div class="flash error"><%= er %></div><% } %>
      <form method="post">
        <%- csrfField() %>
        <label for="status">New status</label>
        <select id="status" name="status">
          <option value="in_progress">In progress</option>
          <option value="resolved">Resolved</option>
        </select>
        <label for="remark">What did you do?</label>
        <textarea id="remark" name="remark" style="min-height:90px"></textarea>
        <p style="margin-top:16px"><button class="btn" type="submit">Post update</button></p>
      </form>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>
