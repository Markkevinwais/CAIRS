<%- include('../partials/header', { title: 'Assigned reports' }) %>
<h1>Assigned reports</h1>
<form class="filters" method="get">
  <select name="status" onchange="this.form.requestSubmit ? this.form.requestSubmit() : this.form.submit()" aria-label="Filter by status">
    <option value="">All statuses</option>
    <% for (const s of ['assigned','in_progress','resolved']) { %>
      <option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= statusLabel(s) %></option>
    <% } %>
  </select>
</form>
<div class="card tablewrap">
<% if (!rows.length) { %><p class="empty">Nothing here.</p><% } else { %>
<table>
  <tr><th>Ref</th><th>Title</th><th>Category</th><th>Location</th><th>Priority</th><th>Status</th><th></th></tr>
  <% for (const r of rows) { %>
  <tr><td><%= refNo(r.id) %></td><td><%= r.title %></td><td><%= r.category %></td><td><%= r.location %></td>
      <td><%- prio(r.priority) %></td><td><%- badge(r.status) %></td><td><a href="report_details.php?id=<%= r.id %>">Open</a></td></tr>
  <% } %>
</table>
<% } %>
</div>
<%- include('../partials/footer') %>
