<%- include('../partials/header', { title: 'Report an incident' }) %>
<div class="page-head">
  <div class="page-head-copy">
    <h1>Report an incident</h1>
    <p class="page-head-sub">Share what happened and pin the location so responders can act quickly.</p>
  </div>
  <div class="page-actions">
    <a class="btn ghost" href="my_reports.php">My reports</a>
  </div>
</div>
<div class="card">
  <% for (const er of errors) { %><div class="flash error"><%= er %></div><% } %>
  <form method="post" enctype="multipart/form-data">
    <%- csrfField() %>
    <div class="report-form-grid">
      <div>
        <label for="category_id">Category</label>
        <select id="category_id" name="category_id" required>
          <option value="">Choose one</option>
          <% for (const c of cats) { %>
            <option value="<%= c.id %>" <%= String(old.category_id) === String(c.id) ? 'selected' : '' %>><%= c.name %></option>
          <% } %>
        </select>
        <label for="title">Title</label>
        <input id="title" name="title" maxlength="150" placeholder="Short summary of the incident" required value="<%= old.title %>">
        <label for="location">Location</label>
        <input id="location" name="location" placeholder="Street, purok, or landmark" required value="<%= old.location %>">
        <label for="description">What happened?</label>
        <textarea id="description" name="description" placeholder="Include helpful details such as hazards, people affected, or landmarks." required><%= old.description %></textarea>
      </div>
      <div>
        <label>Pin the exact spot (optional)</label>
        <%- renderMapPicker(old.latitude, old.longitude) %>
        <label for="photo">Photo (optional, up to 3 MB)</label>
        <input type="file" id="photo" name="photo" accept="image/jpeg,image/png,image/webp">
        <div id="preview"></div>
      </div>
    </div>
    <div class="form-actions">
      <a class="btn ghost" href="dashboard.php">Cancel</a>
      <button class="btn" type="submit">Submit report</button>
    </div>
  </form>
</div>
<%- include('../partials/footer') %>
