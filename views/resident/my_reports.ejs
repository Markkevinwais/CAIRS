<%- include('../partials/header', { title: 'My reports' }) %>
<div class="page-head">
  <div class="page-head-copy">
    <h1>My reports</h1>
    <p class="page-head-sub"><%= rows.length %> report<%= rows.length === 1 ? '' : 's' %> <%= status ? 'matching filter' : 'filed' %></p>
  </div>
  <div class="page-actions">
    <a class="btn" href="report.php"><%- icon('plus', 17) %> Report an incident</a>
  </div>
</div>
<form class="filters filters-compact" method="get">
  <div class="filter-field">
    <select name="status" onchange="this.form.requestSubmit ? this.form.requestSubmit() : this.form.submit()" aria-label="Filter by status">
      <option value="">All statuses</option>
      <% for (const s of ['pending','assigned','in_progress','resolved','rejected']) { %>
        <option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= statusLabel(s) %></option>
      <% } %>
    </select>
  </div>
  <% if (status) { %><a class="btn ghost" href="my_reports.php">Reset</a><% } %>
</form>
<div class="card tablewrap">
<% if (!rows.length) { %><p class="empty">No reports found.</p><% } else { %>
<table>
  <tr><th>Ref</th><th>Title</th><th>Category</th><th>Filed</th><th>Status</th><th class="act">Action</th></tr>
  <% for (const r of rows) { %>
  <tr><td><%= refNo(r.id) %></td><td><%= r.title %></td><td><%= r.category %></td>
      <td><%= fmtDate(r.created_at) %></td><td><%- badge(r.status) %></td>
      <td class="act"><a href="report_details.php?id=<%= r.id %>">View</a></td></tr>
  <% } %>
</table>
<% } %>
</div>
<%- include('../partials/footer') %>
