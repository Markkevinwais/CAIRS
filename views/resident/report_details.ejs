<%- include('../partials/header', { title: refNo(r.id) }) %>
<div class="page-head">
  <div class="page-head-copy">
    <h1><%= r.title %></h1>
    <p class="page-head-sub"><%= refNo(r.id) %> &middot; Filed <%= fmtDate(r.created_at) %></p>
  </div>
  <div class="page-actions">
    <%- badge(r.status) %>
    <button type="button" class="btn ghost small noprint" data-print>Print / Save as PDF</button>
  </div>
</div>
<div class="two">
  <div class="card">
    <dl class="info">
      <dt>Reference</dt><dd><%= refNo(r.id) %></dd>
      <dt>Category</dt><dd><%= r.category %></dd>
      <dt>Location</dt><dd><%= r.location %></dd>
      <dt>Priority</dt><dd><%- prio(r.priority) %></dd>
      <dt>Assigned to</dt><dd><%- r.volunteer_name ? e(r.volunteer_name) : '<span class="muted">Not assigned yet</span>' %></dd>
      <dt>Filed</dt><dd><%= fmtDate(r.created_at) %></dd>
    </dl>
    <h3 style="margin-top:20px">Description</h3>
    <p><%- nl2br(r.description) %></p>
    <% if (r.photo) { %><img class="photo" src="<%= BASE_URL %>/assets/uploads/<%= r.photo %>" alt="Photo attached to the report"><% } %>
    <%- renderMapView(r) %>
  </div>
  <div class="card"><h2>Progress</h2><%- renderTimeline(r.id) %></div>
</div>
<%- include('../partials/footer') %>
