<%- include('../partials/header', { title: 'Reports' }) %>
<div class="page-head">
  <div class="page-head-copy">
    <h1>Reports</h1>
    <p class="page-head-sub"><%= rows.length %> incident report<%= rows.length === 1 ? '' : 's' %> shown</p>
  </div>
  <div class="page-actions noprint">
    <a class="btn ghost small" href="?<%= exportQuery %>">Download Excel (CSV)</a>
    <button type="button" class="btn ghost small" data-print>Print / Save as PDF</button>
  </div>
</div>
<form class="filters" method="get">
  <input class="filter-search" name="q" placeholder="Search title, location or resident" value="<%= q %>">
  <div class="filter-field">
    <select name="status" aria-label="Status">
      <option value="">All statuses</option>
      <% for (const s of ['pending','assigned','in_progress','resolved','rejected']) { %>
        <option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= statusLabel(s) %></option>
      <% } %>
    </select>
  </div>
  <div class="filter-field">
    <select name="category" aria-label="Category">
      <option value="0">All categories</option>
      <% for (const c of cats) { %><option value="<%= c.id %>" <%= cat === c.id ? 'selected' : '' %>><%= c.name %></option><% } %>
    </select>
  </div>
  <button class="btn" type="submit">Filter</button>
  <% if (q || status || cat) { %><a class="btn ghost" href="reports.php">Reset</a><% } %>
</form>
<div class="card tablewrap">
<% if (!rows.length) { %><p class="empty">No reports match these filters.</p><% } else { %>
<table>
  <tr><th>Ref</th><th>Title</th><th>Category</th><th>Resident</th><th>Volunteer</th><th>Priority</th><th>Status</th><th class="noprint act"></th></tr>
  <% for (const r of rows) { %>
  <tr><td><%= refNo(r.id) %></td><td><%= r.title %><%- r.is_sos ? ' <span class="badge sos">SOS</span>' : '' %></td><td><%= r.category %></td>
      <td><%= r.resident_name %></td><td><%= r.volunteer_name || '-' %></td>
      <td><%- prio(r.priority) %></td><td><%- badge(r.status) %></td>
      <td class="noprint act"><a href="report_details.php?id=<%= r.id %>">Open</a></td></tr>
  <% } %>
</table>
<% } %>
</div>
<%- include('../partials/footer') %>
