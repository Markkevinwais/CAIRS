<%- include('../partials/header', { title: 'Settings' }) %>
<h1>Settings</h1>
<div class="two">
  <div class="card">
    <h2>System</h2>
    <form method="post">
      <%- csrfField() %><input type="hidden" name="action" value="site">
      <label for="site_name">System name</label><input id="site_name" name="site_name" required value="<%= setting('site_name') %>">
      <label for="barangay_name">Barangay name</label><input id="barangay_name" name="barangay_name" value="<%= setting('barangay_name') %>">
      <label for="contact_phone">Contact number</label><input id="contact_phone" name="contact_phone" value="<%= setting('contact_phone') %>">
      <label for="map_lat">Map center latitude</label><input id="map_lat" name="map_lat" value="<%= setting('map_lat', '8.4542') %>">
      <label for="map_lng">Map center longitude</label><input id="map_lng" name="map_lng" value="<%= setting('map_lng', '124.6319') %>">
      <p style="margin-top:16px"><button class="btn" type="submit">Save settings</button></p>
    </form>
  </div>
  <div class="card">
    <h2>Change my password</h2>
    <% for (const er of errors) { %><div class="flash error"><%= er %></div><% } %>
    <form method="post">
      <%- csrfField() %><input type="hidden" name="action" value="password">
      <label for="current">Current password</label><input type="password" id="current" name="current" required>
      <label for="new">New password</label><input type="password" id="new" name="new" required minlength="6">
      <p style="margin-top:16px"><button class="btn" type="submit">Change password</button></p>
    </form>
  </div>
</div>
<div class="card" style="max-width:560px">
  <h2>Emergency hotlines</h2>
  <p class="muted">Shown to residents on their dashboard and on the SOS page. Leave a box empty to hide it.</p>
  <form method="post">
    <%- csrfField() %><input type="hidden" name="action" value="hotlines">
    <label for="emergency_hotline">Emergency (e.g. 911)</label><input id="emergency_hotline" name="emergency_hotline" value="<%= setting('emergency_hotline', '911') %>">
    <label for="hotline_fire">Fire station</label><input id="hotline_fire" name="hotline_fire" value="<%= setting('hotline_fire') %>">
    <label for="hotline_police">Police</label><input id="hotline_police" name="hotline_police" value="<%= setting('hotline_police') %>">
    <label for="hotline_medical">Medical / ambulance</label><input id="hotline_medical" name="hotline_medical" value="<%= setting('hotline_medical') %>">
    <p style="margin-top:16px"><button class="btn" type="submit">Save hotlines</button></p>
  </form>
</div>
<div class="card" style="max-width:560px;margin-top:20px">
  <h2>SMS alerts</h2>
  <p class="muted">Residents and volunteers get a text when a report changes. Uses your own Semaphore account (semaphore.co); each message uses SMS credits.</p>
  <form method="post">
    <%- csrfField() %><input type="hidden" name="action" value="sms">
    <label><input type="checkbox" name="sms_enabled" value="1" style="width:auto" <%= setting('sms_enabled', '0') === '1' ? 'checked' : '' %>> Send SMS alerts</label>
    <label for="sms_api_key">Semaphore API key</label>
    <input id="sms_api_key" name="sms_api_key" type="password" autocomplete="off" placeholder="<%= setting('sms_api_key') !== '' ? 'Saved. Leave blank to keep it.' : 'Paste your API key' %>">
    <label for="sms_sender">Sender name (optional)</label>
    <input id="sms_sender" name="sms_sender" maxlength="11" value="<%= setting('sms_sender') %>">
    <p style="margin-top:16px"><button class="btn" type="submit">Save SMS settings</button></p>
  </form>
  <form method="post" style="margin-top:8px"><%- csrfField() %><input type="hidden" name="action" value="sms_test">
    <button class="btn ghost small" type="submit">Send a test SMS to my phone</button>
  </form>
</div>
<%- include('../partials/footer') %>
