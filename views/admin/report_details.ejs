<%- include('../partials/header', { title: refNo(r.id) }) %>
<div class="page-head"><h1><%= r.title %></h1><span><%- badge(r.status) %> <button type="button" class="btn ghost small noprint" data-print>Print / Save as PDF</button></span></div>
<div class="two">
  <div>
    <div class="card">
      <dl class="info">
        <dt>Reference</dt><dd><%= refNo(r.id) %></dd>
        <dt>Category</dt><dd><%= r.category %></dd>
        <dt>Location</dt><dd><%= r.location %></dd>
        <dt>Resident</dt><dd><%= r.resident_name %> <span class="muted"><%= r.resident_phone %></span></dd>
        <dt>Filed</dt><dd><%= fmtDate(r.created_at) %></dd>
      </dl>
      <h3 style="margin-top:20px">Description</h3>
      <p><%- nl2br(r.description) %></p>
      <% if (r.photo) { %><img class="photo" src="<%= BASE_URL %>/assets/uploads/<%= r.photo %>" alt="Photo attached to the report"><% } %>
      <%- renderMapView(r) %>
    </div>
    <div class="card"><h2>History</h2><%- renderTimeline(r.id) %></div>
  </div>
  <div class="card">
    <h2>Manage</h2>
    <% for (const er of errors) { %><div class="flash error"><%= er %></div><% } %>
    <form method="post">
      <%- csrfField() %>
      <label for="volunteer_id">Volunteer</label>
      <select id="volunteer_id" name="volunteer_id">
        <option value="0">Not assigned</option>
        <% for (const v of vols) { %><option value="<%= v.id %>" <%= Number(r.volunteer_id) === v.id ? 'selected' : '' %>><%= v.full_name %></option><% } %>
      </select>
      <label for="priority">Priority</label>
      <select id="priority" name="priority">
        <% for (const p of ['low','medium','high']) { %><option value="<%= p %>" <%= r.priority === p ? 'selected' : '' %>><%= p.charAt(0).toUpperCase() + p.slice(1) %></option><% } %>
      </select>
      <label for="status">Status</label>
      <select id="status" name="status">
        <% for (const s of statuses) { %><option value="<%= s %>" <%= r.status === s ? 'selected' : '' %>><%= statusLabel(s) %></option><% } %>
      </select>
      <label for="remark">Remark (the resident can see this)</label>
      <textarea id="remark" name="remark" style="min-height:80px"></textarea>
      <p style="margin-top:16px"><button class="btn" type="submit">Save changes</button></p>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
