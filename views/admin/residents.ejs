<%- include('../partials/header', { title: 'Residents' }) %>
<div class="page-head">
  <div class="page-head-copy">
    <h1>Residents</h1>
    <p class="page-head-sub"><%= rows.length %> registered resident account<%= rows.length === 1 ? '' : 's' %></p>
  </div>
</div>
<div class="card tablewrap">
<% if (!rows.length) { %><p class="empty">No residents have registered yet.</p><% } else { %>
<table>
  <tr><th>Name</th><th>Email</th><th>Phone</th><th>Address</th><th class="num">Reports</th><th>Status</th><th class="act"></th></tr>
  <% for (const u of rows) { %>
  <tr><td><%= u.full_name %></td><td><%= u.email %></td><td><%= u.phone || '-' %></td><td><%= u.address || '-' %></td>
      <td class="num"><%= u.total %></td><td><span class="badge <%= u.status === 'active' ? 's-resolved' : 's-rejected' %>"><%= u.status.charAt(0).toUpperCase() + u.status.slice(1) %></span></td>
      <td class="act"><form method="post" data-confirm="Change this resident's status?"><%- csrfField() %>
        <input type="hidden" name="id" value="<%= u.id %>">
        <button class="btn small <%= u.status === 'active' ? 'danger' : '' %>" type="submit"><%= u.status === 'active' ? 'Deactivate' : 'Activate' %></button></form></td></tr>
  <% } %>
</table>
<% } %>
</div>
<%- include('../partials/footer') %>
