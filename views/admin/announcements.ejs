<%- include('../partials/header', { title: 'Announcements' }) %>
<h1>Announcements</h1>
<div class="two">
  <div>
    <% if (!rows.length) { %><div class="card"><p class="empty">No announcements yet. Post the first one.</p></div><% } %>
    <% for (const a of rows) { %>
    <article class="ann ann-<%= a.level %><%= a.is_active ? '' : ' is-off' %>">
      <span class="ann-ic"><%- icon(a.level === 'critical' ? 'siren' : 'megaphone', 20) %></span>
      <div>
        <strong><%= a.title %></strong> <%- a.is_active ? '' : '<span class="badge">Hidden</span>' %>
        <p><%- nl2br(a.body) %></p>
        <span class="muted"><%= fmtDate(a.created_at) %> &middot; <%= a.full_name %> &middot; <%= a.level.charAt(0).toUpperCase() + a.level.slice(1) %></span>
        <div class="ann-actions">
          <form method="post"><%- csrfField() %>
            <input type="hidden" name="action" value="toggle"><input type="hidden" name="id" value="<%= a.id %>">
            <button class="btn ghost small" type="submit"><%= a.is_active ? 'Hide' : 'Show again' %></button></form>
          <form method="post" data-confirm="Delete this announcement for good?"><%- csrfField() %>
            <input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="<%= a.id %>">
            <button class="btn danger small" type="submit">Delete</button></form>
        </div>
      </div>
    </article>
    <% } %>
  </div>

  <div class="card">
    <h2>Post an announcement</h2>
    <% for (const er of errors) { %><div class="flash error"><%= er %></div><% } %>
    <form method="post">
      <%- csrfField() %><input type="hidden" name="action" value="add">
      <label for="title">Title</label>
      <input id="title" name="title" maxlength="150" required value="<%= old.title %>">
      <label for="level">Level</label>
      <select id="level" name="level">
        <% for (const l of levels) { %><option value="<%= l %>" <%= old.level === l ? 'selected' : '' %>><%= l.charAt(0).toUpperCase() + l.slice(1) %></option><% } %>
      </select>
      <label for="body">Message</label>
      <textarea id="body" name="body" required style="min-height:110px"><%= old.body %></textarea>
      <p style="margin-top:16px"><button class="btn" type="submit">Post announcement</button></p>
    </form>
    <p class="muted" style="margin-top:14px">Active announcements show on the home page and on the resident and volunteer dashboards. Use <b>Critical</b> only for real emergencies.</p>
  </div>
</div>
<%- include('../partials/footer') %>
